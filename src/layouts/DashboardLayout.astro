      </header>
      <slot />
    </div>
    <Footer />
  </section>
  <Modal id='modal-profile'>
    <ModalBody>
      <h1 class='mb-5 text-xl'>Perfil</h1>
      <form class='mb-4 flex flex-col gap-4' id='form-change-password'>
        <Input disabled label='RUC' name='ruc' htmlFor='ruc' id='ruc' />
        <Input
          disabled
          label='Nombre comercial'
          name='name'
          htmlFor='name'
          id='name'
        />
        <div>
          <label for='password' class='text-xs'>Contraseña actual</label>
          <WithTogglePassword>
            <Input required name='password' id='password' type='password' />
          </WithTogglePassword>
        </div>
        <div>
          <label for='newPassword' class='text-xs'>Nueva contraseña</label>
          <WithTogglePassword>
            <Input
              required
              id='newPassword'
              name='newPassword'
              type='password'
              minlength='5'
            />
          </WithTogglePassword>
        </div>
        <div>
          <label for='confirmPassword' class='text-xs'
            >Confirmar contraseña</label
          >
          <WithTogglePassword>
            <Input
              required
              id='confirmPassword'
              name='confirmPassword'
              type='password'
              minlength='5'
            />
          </WithTogglePassword>
        </div>
        <p
          id='password-error'
          class='hidden gap-2 text-xs text-rosewood transition-all'
        >
          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='16'
            height='16'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            class='lucide lucide-info-icon lucide-info'
            ><circle cx='12' cy='12' r='10'></circle><path d='M12 16v-4'
            ></path><path d='M12 8h.01'></path></svg
          >
          <span></span>
        </p>
        <div class='flex justify-end gap-4'>
          <Button
            as='button'
            data-modal-close
            class='!bg-[#ededed] !text-eerie-black'>Cancelar</Button
          >
          <Button id='form-change-password-submit' as='button' type='submit'
            >Guardar</Button
          >
        </div>
      </form>
    </ModalBody>
  </Modal>
</main>
<script>
  import { getLangFromUrl, useTranslatedPath } from 'i18n/utils'
  import {
    getToken,
    getPayload,
    hasExpiredToken,
    removeToken,
  } from 'adapters/jwt'
  import { updatePassword } from 'services/auth'
  import { closeModal } from 'organism/modal'
  import { Toast } from 'ui/Toast'
  const $ = document.querySelector.bind(document)
  const $logout = $('#logout')
  const $name = $('input#name') as HTMLInputElement
  const $ruc = $('input#ruc') as HTMLInputElement
  const $modalProfile = $('#modal-profile') as HTMLDialogElement
  const $formChangePassword = $('#form-change-password') as HTMLFormElement
  const $passwordError = $('#password-error') as HTMLParagraphElement
  const $currentPassowrd = $('#password') as HTMLInputElement
  const $newPassword = $('#newPassword') as HTMLInputElement
  const $confirmPassword = $('#confirmPassword') as HTMLInputElement
  const $errorMessage = $passwordError.querySelector('span') as HTMLSpanElement
  const token = getToken() as string
  const payload = getPayload(token)
  const lang = getLangFromUrl(
    new URL(window?.location?.pathname, window?.location?.origin)
  )
  const translatePath = useTranslatedPath(lang)
  const currentToken = getToken() ?? ''
  if (!currentToken) {
    window.location.replace(translatePath('/login'))
  }

  if (hasExpiredToken(currentToken)) {
    window.location.replace(translatePath('/login'))
  }

  $logout?.addEventListener('click', () => {
    location.href = '/'
    removeToken()
  })
  $name.value = payload.commercial_name
  $ruc.value = payload.ruc

  $formChangePassword.addEventListener('submit', async (e) => {
    e.preventDefault()
    $passwordError.classList.add('hidden')
    const form = new FormData(e.currentTarget as HTMLFormElement)
    const credentials = Object.fromEntries(form)

    if (credentials.newPassword !== credentials.confirmPassword) {
      $passwordError.classList.add('flex')
      $passwordError.classList.remove('hidden')
      $errorMessage.innerText = 'Las contraseñas no coinciden'
      return
    }

    try {
      await updatePassword({
        username: payload.ruc,
        currentPassword: credentials.password as string,
        newPassword: credentials.newPassword as string,
      })
      $newPassword.value = ''
      $confirmPassword.value = ''
      $currentPassowrd.value = ''
      closeModal($modalProfile)
      new Toast({
        text: 'Contraseña actualizada correctamente',
        autoClose: 3000,
      })
    } catch (e) {
      $passwordError.classList.add('flex')
      $passwordError.classList.remove('hidden')
      $errorMessage.innerText = 'La contraseña actual es incorrecta'
    }
  })
</script>
