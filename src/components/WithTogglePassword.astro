<div id="with-toggle-password" class="relative">
  <slot />
  <button
    type="button"
    data-show-password="false"
    class="absolute right-2 top-1/2 -translate-y-1/2 appearance-none"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="lucide lucide-eye-icon lucide-eye"
      ><path
        d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"
      ></path><circle cx="12" cy="12" r="3"></circle></svg
    >
  </button>
</div>
<script>
  const $$ = document.querySelectorAll.bind(document)
  const $$wrapper = Array.from(
    $$('#with-toggle-password')
  ) as Array<HTMLDivElement>

  const canShowPassword = ($el: HTMLElement) => {
    return $el.dataset.showPassword === 'true'
  }

  const toggleInput = ($input: HTMLInputElement, isPassword: boolean) => {
    $input.setAttribute('type', isPassword ? 'text' : 'password')
  }

  const togglePasswordIcons = ({
    button,
    input,
  }: {
    button: HTMLButtonElement
    input: HTMLInputElement
  }) => {
    button.addEventListener('click', () => {
      const showPassword = !canShowPassword(button)
      button.setAttribute('data-show-password', `${showPassword}`)
      // input.setAttribute('type', showPassword ? 'text' : 'password')
      toggleInput(input, showPassword)
      button.replaceChildren('')
      button.insertAdjacentHTML(
        'beforeend',
        showPassword ? $closedEyes : $openEyes
      )
    })
  }

  $$wrapper.forEach(($el) => {
    const $togglePassword = $el.querySelector('button') as HTMLButtonElement
    const $currentPassword = $el.querySelector(
      'input[type="password"]'
    ) as HTMLInputElement
    togglePasswordIcons({ button: $togglePassword, input: $currentPassword })
  })
  const $openEyes = `
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-eye-icon lucide-eye"
              ><path
                d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"
              ></path><circle cx="12" cy="12" r="3"></circle></svg
            >

`
  const $closedEyes = `
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-eye-off-icon lucide-eye-off"
              ><path
                d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"
              ></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"
              ></path><path
                d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"
              ></path><path d="m2 2 20 20"></path></svg
            >
`
  // const $togglePassword = $('#toggle-show-password') as HTMLButtonElement
</script>
