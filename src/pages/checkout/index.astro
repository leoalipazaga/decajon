---
import { Picture } from 'astro:assets'
import { currency } from 'utils'
import BaseLayout from 'layouts/BaseLayout.astro'
import Layout from 'layouts/Layout.astro'
import MiddlewareLayout from 'layouts/MiddlewareLayout.astro'
import SandLayout from 'layouts/SandLayout.astro'
import Input from 'components/Input.astro'
import Button from 'components/Button.astro'
import { getLangFromUrl, useTranslatedPath, useTranslations } from 'i18n/utils'
import Carousel from 'components/Carousel.astro'
import BottleVodka from 'images/bottle-vodka-compressed.png'
import BottleSiembra from 'images/bottle-siembra.png'
import BottleGin from 'images/bottle-gin.png'
import ProductCheckout from './_components/product-checkout.svelte'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
const bottles = [
  {
    title: 'DE CAJÓN VODKA',
    img: { alt: 'De Cajon Vodka', src: BottleVodka },
    link: '/products/vodka',
    size: '750',
  },
  {
    title: 'DE CAJÓN GIN',
    img: { alt: 'DE CAJÓN GIN', src: BottleGin },
    link: '/products/vodka-gin',
    size: '750',
  },
  {
    title: 'SIEMBRA VODKA',
    img: { alt: 'SIEMBRA VODKA', src: BottleSiembra },
    link: '/products/vodka-siembra',
    size: '750',
  },
]
---

<Layout title='Checkout'>
  <MiddlewareLayout>
    <BaseLayout>
      <SandLayout class='py-24'>
        <div class='m-auto w-[76%] max-w-screen-2xl'>
          <form
            id='formCheckout'
            class='hidden grid-cols-1 md:grid-cols-2 md:gap-x-24'
          >
            <article class='grid grid-cols-2'>
              <header class='col-span-2 mb-10 flex flex-col md:flex-row'>
                <h1
                  class='col-span-2 text-xl uppercase md:col-span-1 md:text-2xl lg:text-center'
                >
                  {t('checkout.finishShop')}
                </h1>
                <h3
                  id='countProducts'
                  class='col-span-2 text-nowrap text-xl md:col-span-1 lg:text-center'
                >
                </h3>
              </header>
              <p class='col-span-2 text-base md:text-xl'>
                {t('checkout.detailsShop')}
              </p>
              <Input
                required
                autocomplete='off'
                class='col-span-2 mb-4'
                label='Nombre'
                name='name'
                id='name'
              />
              <Input
                required
                autocomplete='off'
                class='col-span-2 mb-4'
                label='Apellidos'
                name='lastname'
                id='lastname'
              />
              <p translate='no' class='col-span-2 mb-4'>Lima/Perú</p>
              <label class='col-span-2 text-xs'>{t('checkout.district')}</label>
              <select
                required
                id='districts'
                class='col-span-2 mb-4 border border-eerie-black bg-transparent px-2.5 py-1'
                name='district'
              >
              </select>
              <Input
                required
                autocomplete='off'
                class='col-span-2 mb-4'
                label='Direccion'
                name='address'
                id='address'
              />
              <input id='regions' name='regions' hidden value='3926' />
              <input id='provinces' name='provinces' hidden value='3927' />
              <Input
                required
                autocomplete='off'
                class='col-span-2 mb-4'
                type='tel'
                label={t('common.phone')}
                id='phone'
                name='phone'
              />
              <Input
                required
                autocomplete='off'
                class='col-span-2 mb-4'
                type='email'
                label={t('common.email')}
                id='email'
                name='email'
              />
              <label class='col-span-2 text-xs'>{t('checkout.notes')}</label>
              <textarea
                class='col-span-2 min-h-40 border border-eerie-black bg-transparent px-2.5 py-1'
                name='notes'></textarea>
              <Button
                as='button'
                id='buttonCheckout'
                class='col-span-2 mt-10 block md:hidden'
              >
                {t('checkout.finishShop')}
              </Button>
            </article>
            <article class='hidden md:block'>
              <a
                class='mb-10 block text-base text-rosewood'
                href={translatePath('/products')}
              >
                {t('cart.continueShop')}
              </a>
              <div class='grid grid-cols-2 border px-4 py-5'>
                <h2 class='col-span-2 mb-9 text-center font-thabit text-xl'>
                  {t('checkout.yourOrder')}
                </h2>
                <ProductCheckout client:only='svelte' />
                <div
                  class='col-span-2 grid grid-cols-2 border-b px-[0.625rem] py-4'
                >
                  <p class='text-base'>{t('checkout.delivery')}:</p>
                  <p class='justify-self-end text-base'>{currency(10)}</p>
                </div>
                <div
                  class='col-span-2 grid grid-cols-2 border-b px-[0.625rem] py-4'
                >
                  <p class='text-base'>{t('common.total')}:</p>
                  <p id='total' class='justify-self-end text-base'></p>
                </div>
                <Button
                  type='submit'
                  id='buttonCheckout'
                  class='relative col-span-2 mt-10 block'
                >
                  {t('checkout.finishShop')}
                </Button>
              </div>
            </article>
          </form>
          <div
            id='empty'
            class='hidden grid-cols-1 gap-x-6 gap-y-[0.875rem] md:grid-cols-3'
          >
            <h2
              class='col-span-3 border-y border-y-eerie-black py-6 text-center text-sm uppercase'
            >
              {t?.('cart.empty')}
            </h2>
            <div class='block md:hidden'>
              <Carousel>
                {
                  bottles.map((bottle) => (
                    <article class='flex w-full flex-shrink-0 flex-col items-center border border-eerie-black py-[1.125rem]'>
                      <Picture
                        alt={bottle.img.alt}
                        class='mb-4 h-[260px] object-cover'
                        height={260}
                        src={bottle.img.src}
                        loading='lazy'
                        formats={['webp', 'avif', 'jpg']}
                      />
                      <h2 class='mb-3 text-center uppercase md:text-sm lg:text-2xl'>
                        {bottle.title}
                      </h2>
                      <p class='mb-3 text-center md:text-xs lg:text-xl'>
                        {t('common.bottle')} {bottle.size}ml
                      </p>
                      <Button as='a' href={translatePath(bottle.link)}>
                        {t('common.buyNow')}
                      </Button>
                    </article>
                  ))
                }
              </Carousel>
            </div>
            {
              bottles.map((bottle) => (
                <article class='hidden flex-col items-center border border-eerie-black py-[1.125rem] md:flex'>
                  <Picture
                    alt={bottle.img.alt}
                    class='mb-4 h-[260px] object-cover'
                    height={260}
                    src={bottle.img.src}
                    widths={[176]}
                    sizes={`${176}px`}
                    loading='lazy'
                    formats={['webp', 'avif', 'jpg']}
                  />
                  <h2 class='mb-3 text-center uppercase md:text-sm lg:text-2xl'>
                    {bottle.title}
                  </h2>
                  <p class='mb-3 text-center md:text-xs lg:text-xl'>
                    {t('common.bottle')} {bottle.size}ml
                  </p>
                  <Button as='a' href={translatePath(bottle.link)}>
                    {t('common.buyNow')}
                  </Button>
                </article>
              ))
            }
          </div>
        </div>
      </SandLayout>
    </BaseLayout>
  </MiddlewareLayout>
</Layout>
<script
  is:inline
  src='https://static-content-qas.vnforapps.com/env/sandbox/js/checkout.js'
></script>
<script>
  import { clearCart, getCountProducts, getTotal } from 'adapters/storage'
  import { districts, provinces, regions } from 'consts'
  import { currency } from 'utils'
  import Notification from 'icons/notification.svg'
  import {
    getLangFromUrl,
    useTranslatedPath,
    useTranslations,
  } from 'i18n/utils'
  import DeCajonLogo from 'images/decajon-logo.png'
  import { Modal } from './_components/modal'

  const lang = getLangFromUrl(
    new URL(window?.location?.pathname, window?.location?.origin)
  )
  const translatePath = useTranslatedPath(lang)
  const $provinces = document.querySelector('#provinces')
  const $districts = document.querySelector('#districts') as HTMLSelectElement
  const $countProducts = document.querySelectorAll('#countProducts')
  const $$total = document.querySelectorAll('#total')
  const $address = document.querySelector('#address') as HTMLInputElement
  const $phone = document.querySelector('#phone') as HTMLInputElement
  const $email = document.querySelector('#email') as HTMLInputElement
  const $empty = document.querySelector('#empty') as HTMLDivElement
  const $formCheckout = document.querySelector(
    '#formCheckout'
  ) as HTMLFormElement
  const $buttonCheckout = document.querySelectorAll(
    '#buttonCheckout'
  ) as NodeListOf<HTMLButtonElement>
  const merchantId = import.meta.env.PUBLIC_NIUBIZ_MERCHANT_ID
  const purchaseNumber = Number.parseInt(`${Math.random() * 1000}`, 10)
  const documentStyle = document.documentElement.style.cssText
  const bodyStyle = document.body.style.cssText
  const t = useTranslations(lang)

  if (getTotal()) {
    $formCheckout.classList.toggle('hidden')
    $formCheckout.classList.toggle('grid')
  } else {
    $empty.classList.toggle('hidden')
    $empty.classList.toggle('grid')
  }

  $$total?.forEach(($el) => {
    $el?.insertAdjacentText('afterbegin', `${currency(getTotal() + 10)}`)
  })

  $countProducts?.forEach(($el) => {
    $el?.insertAdjacentText(
      'afterbegin',
      `(${getCountProducts()} ${getCountProducts() === 1 ? t('common.product') : t('common.products')})`
    )
  })

  const getDistricts = (ubigeo: keyof typeof districts) => {
    return [...districts[ubigeo]].sort()
  }

  const getRegionByUbigeo = (ubigeo: string) => {
    return regions.find((region) => region.id_ubigeo === ubigeo)
  }

  const getProvinceByIbigeo = (values: {
    regionUbigeo: keyof typeof provinces
    provinceUbigeo: string
  }) => {
    return provinces[values.regionUbigeo].find(
      (province) => province.id_ubigeo === values.provinceUbigeo
    )
  }

  const getDistrictByUbigeo = (values: {
    provinceUbigeo: keyof typeof districts
    districtUbigeo: string
  }) => {
    return districts[values.provinceUbigeo].find(
      (district) => district.id_ubigeo === values.districtUbigeo
    )
  }

  getDistricts(
    ($provinces as HTMLInputElement)?.value as keyof typeof districts
  ).forEach((district) => {
    $districts?.insertAdjacentHTML(
      'afterbegin',
      `<option id=${district.id_ubigeo} value=${district.id_ubigeo}>${district.nombre_ubigeo}</option>`
    )
  })

  declare const VisanetCheckout: {
    Iframe: any
    configuration: { complete: (...args: any) => void }
    open(): any
    configure(param: any): any
  }

  $formCheckout.addEventListener('submit', async (e) => {
    e.preventDefault()
    const form = new FormData(e.target as HTMLFormElement)
    const user = Object.fromEntries(form.entries()) as {
      address: string
      email: string
      district: string
      name: string
      lastname: string
      notes: string
      phone: string
      provinces: string
      regions: string
    }
    const district = getDistrictByUbigeo({
      provinceUbigeo: user.provinces as keyof typeof districts,
      districtUbigeo: user.district,
    })

    $buttonCheckout.forEach(($el) => {
      $el.disabled = true
      $el.classList.toggle('opacity-75')
      $el.insertAdjacentHTML(
        'afterbegin',
        `
      <div
                    class='border-current text-surface dark:text-white inline-block size-3 animate-spin rounded-full border-4 border-solid border-e-transparent align-[-0.125em] motion-reduce:animate-[spin_1.5s_linear_infinite]'
                    role='status'
                  >
                    <span
                      class='!absolute !-m-px !h-px !w-px !overflow-hidden !whitespace-nowrap !border-0 !p-0 ![clip:rect(0,0,0,0)]'
                      >Loading...</span
                    >
                  </div>

      `
      )
    })
    const fetchAccess = await fetch(
      `${import.meta.env.PUBLIC_DECAJON_API}/checkout.php`
    )
    const accessToken = await fetchAccess.text()
    const fetchSession = await fetch(
      `${import.meta.env.PUBLIC_NIUBIZ_SESSION_TOKEN_URL}/${merchantId}`,
      {
        method: 'POST',
        headers: {
          Authorization: accessToken,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          channel: 'web',
          amount: getTotal() + 10,
          antifraud: {
            clientIp: '24.252.107.29',
            merchantDefineData: {
              MDD4: user.email,
              MDD32: user.email,
              // Registered - Guest - Employee
              MDD75: 'Guest',
              MDD77: 458,
            },
          },
          datamap: {
            cardholderCity: 'Lima',
            cardholderCountry: 'PE',
            cardholderAddress: user.address,
            cardholderPostalCode: '12345',
            cardholderState: 'LIM',
            cardholderPhoneNumber: user.phone,
          },
        }),
      }
    )
    const session = await fetchSession.json()
    VisanetCheckout.configure({
      sessiontoken: session.sessionKey,
      channel: 'web',
      merchantid: merchantId,
      purchasenumber: purchaseNumber,
      amount: getTotal() + 10,
      expirationminutes: '5',
      timeouturl: location.href,
      merchantlogo: DeCajonLogo.src,
      merchantname: 'DeCajon',
      formbuttoncolor: '#000000',
      action: '/',
      cancel: function () {
        $buttonCheckout.forEach(($el) => {
          $el.removeAttribute('disabled')
          $el.classList.toggle('opacity-75')
          $el.querySelector('[role="status"]')?.remove()
        })
      },
    })
    VisanetCheckout.open()
    VisanetCheckout.configuration.complete = procesar
    async function procesar(parametros: { channel: string; token: string }) {
      try {
        const res = await fetch(
          `${import.meta.env.PUBLIC_NIUBIZ_TRANSACTION_URL}/${merchantId}`,
          {
            method: 'POST',
            headers: {
              Authorization: accessToken,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              channel: parametros.channel,
              captureType: 'manual',
              accountable: true,
              countable: true,
              order: {
                tokenId: parametros.token,
                purchaseNumber: purchaseNumber,
                amount: getTotal() + 10,
                currency: 'PEN',
              },
              dataMap: {
                urlAddress: '',
                partnerIdCode: '',
                serviceLocationCityName: district?.nombre_ubigeo,
                serviceLocationCountrySubdivisionCode: '',
                serviceLocationCountryCode: 'PER',
                serviceLocationPostalCode: '',
              },
            }),
          }
        )
        const transaction = await res.json()
        const modal = Object.create(Modal)
        $buttonCheckout.forEach(($el) => {
          $el.removeAttribute('disabled')
          $el.classList.toggle('opacity-75')
          $el.querySelector('[role="status"]')?.remove()
        })
        document.documentElement.style.cssText = documentStyle
        document.body.style.cssText = bodyStyle
        document.querySelector('#visaNetWrapper')?.remove()
        VisanetCheckout.Iframe.prototype.close.call({
          iframe: { style: { display: 'block' } },
          ...VisanetCheckout.Iframe,
        })
        const actionCode = (transaction.dataMap ?? transaction.data)
          .ACTION_CODE as
          | '000'
          | '101'
          | '102'
          | '113'
          | '116'
          | '118'
          | '129'
          | '190'
          | '191'
          | '401'
          | '476'
          | '479'
          | '666'
          | '668'
          | '670'
          | '678'
          | '754'
        if (actionCode === '000') {
          return modal.open({
            title: t?.('checkout.successfull'),
            icon: Notification.src,
            ok: {
              title: t?.('checkout.close'),
              onClick: () => {
                location.replace(translatePath?.('/products'))
                clearCart()
              },
            },
            description: t?.(`checkout.${actionCode}`),
          })
        }
        if (t?.(`checkout.${actionCode}`)) {
          return modal.open({
            title: t?.('checkout.invalid'),
            icon: Notification.src,
            ok: {
              title: t?.('checkout.close'),
              onClick: () => {
                location.replace(translatePath?.('/checkout'))
              },
            },
            description: t?.(`checkout.${actionCode}`),
          })
        }

        return modal.open({
          title: t?.('checkout.invalid'),
          icon: Notification.src,
          ok: {
            title: t?.('checkout.close'),
            onClick: () => {
              location.replace(translatePath?.('/checkout'))
            },
          },
          description: t?.(`checkout.paymentError`),
        })
      } catch (error) {
        console.error('There was an error. Try again', error)
      }
    }
  })
</script>
