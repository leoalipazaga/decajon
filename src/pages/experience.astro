---
import { changeLanguage } from "i18next";
import { Image, Picture } from "astro:assets";
import BaseLayout from "layouts/BaseLayout.astro";
import Layout from "layouts/Layout.astro";
import MiddlewareLayout from "layouts/MiddlewareLayout.astro";
import SandLayout from "layouts/SandLayout.astro";
import CoctelesBanner from "images/coctelesbanner.png";
import BottleVodka from "images/bottle-vodka-compressed.png";
import BottleSiembra from "images/bottle-siembra.png";
import BottleGin from "images/bottle-gin.png";
import LongLeftArrow from "icons/long-left-arrow.svg";
import Button from "components/Button.astro";
import Coctel from "components/Coctel.astro";
import Input from "components/Input.astro";
import Carousel from "components/Carousel.astro";
import { getLangFromUrl, useTranslatedPath, useTranslations } from "i18n/utils";
import { getCocktailImg } from "coctel/coctel.usecases";
import { cocteles } from "coctel/coctel.const";

changeLanguage("es");

const bottles = [
    {
        title: "DE CAJ\u00D3N VODKA",
        img: { alt: "De Cajon Vodka", src: BottleVodka },
        link: "/products/vodka",
        size: "750",
    },
    {
        title: "DE CAJ\u00D3N GIN",
        img: { alt: "DE CAJ\u00D3N GIN", src: BottleGin },
        link: "/products/vodka-gin",
        size: "750",
    },
    {
        title: "SIEMBRA VODKA",
        img: { alt: "SIEMBRA VODKA", src: BottleSiembra },
        link: "/products/vodka-siembra",
        size: "750",
    },
];
const lang = getLangFromUrl(Astro.url);
const t = useTranslations();
const translatePath = useTranslatedPath(lang);
---

<Layout title='Cocteles'>
  <MiddlewareLayout>
    <BaseLayout>
      <SandLayout class='relative pl-14 md:pl-28'>
        <div
          class='m-auto grid max-w-screen-2xl justify-between md:grid-cols-[50%_auto] lg:grid-cols-[35%_50%]'
        >
          <header
            class='col-start-1 row-start-1 w-4/5 space-y-2 self-center md:w-full md:space-y-7'
          >
            <p class='text-xs md:text-sm lg:text-xl'>
              {t('experience.preheading')}
            </p>
            <h1 class='text-xl uppercase lg:text-3xl xl:text-5xl'>
              {t('experience.title')}
            </h1>
            <p class='text-xs md:text-sm lg:text-sm xl:text-xl'>
              {t('experience.description')}
            </p>
            <Button class='hidden md:flex' variant='rounded' id='scroll-to'>
              <Image class='-rotate-90' src={LongLeftArrow} alt='long left' />
            </Button>
          </header>
          <Picture
            src={CoctelesBanner}
            pictureAttributes={{
              class:
                'col-start-1 col-end-2 md:w-full w-[70%] md:col-start-2 md:col-end-3 row-start-1 opacity-30 md:opacity-100 w-full justify-self-end',
            }}
            height={832}
            class='aspect-[2/3] w-full'
            alt='cocteles-banner'
            formats={['webp', 'png', 'avif', 'jpeg']}
          />
        </div>
      </SandLayout>
      <SandLayout class='py-[4.25rem]' id='recipes'>
        <div class='m-auto w-[76%] max-w-screen-2xl'>
          <form
            id='form-filter'
            class='mb-10 grid gap-x-5 gap-y-4 md:grid-cols-2 md:gap-y-0'
          >
            <Input
              id='searchbox'
              name='searchbox'
              type='search'
              autocomplete='off'
              placeholder={t('experience.searchProducts')}
              rounded
            />
            <select class='border bg-transparent py-2 pl-2' name='distillate'>
              <option value=''>Todos</option>
              <option value='De Cajón Vodka'>De Cajón Vodka</option>
              <option value='De Cajón Gin'>De Cajón Gin</option>
              <option value='Siembra Vodka'>Siembra Vodka</option>
            </select>
          </form>
          <h2 class='mb-8 uppercase md:text-xl lg:text-2xl'>
            {t('experience.recipesTitle')}&nbsp(<span id='cocteles-count'
              >{cocteles.length}</span
            >
            )
          </h2>
          <div
            class='grid grid-cols-1 gap-x-[1.25rem] gap-y-5 md:grid-cols-3 md:gap-y-4 lg:gap-y-12'
            id='cocteles'
          >
            {
              cocteles.map((coctel) => (
                <Coctel tag={coctel.distillate} title={coctel.name}>
                  <Image
                    class='col-span-2 row-start-1 h-full w-full object-cover object-[10%_80%]'
                    src={getCocktailImg(coctel.alias)}
                    alt={coctel.alias}
                    loading='lazy'
                    height='284'
                  />
                </Coctel>
              ))
            }
          </div>
        </div>
        <SandLayout class='py-[4.375rem]'>
          <div
            class='m-auto grid w-[76%] max-w-screen-2xl grid-cols-1 grid-rows-[auto_auto] gap-x-6 gap-y-[0.875rem] md:grid-cols-3'
          >
            <h1
              class='col-span-1 col-start-1 row-start-1 border border-eerie-black py-[0.825rem] text-center text-xl uppercase md:col-span-3 lg:text-4xl'
            >
              {t('experience.similarProducts')}
            </h1>
            <div class='block md:hidden'>
              <Carousel>
                {
                  bottles.map((bottle) => (
                    <article class='flex w-full flex-shrink-0 flex-col items-center border border-eerie-black py-[1.125rem]'>
                      <Picture
                        alt={bottle.img.alt}
                        class='mb-4 h-[260px] object-cover'
                        height={260}
                        src={bottle.img.src}
                        loading='lazy'
                        formats={['webp', 'avif', 'jpg']}
                      />
                      <h2
                        translate='no'
                        class='mb-3 text-center uppercase md:text-sm lg:text-2xl'
                      >
                        {bottle.title}
                      </h2>
                      <p class='mb-3 text-center md:text-xs lg:text-xl'>
                        {t('common.bottle')} {bottle.size}ml
                      </p>
                      <Button as='a' href={translatePath(bottle.link)}>
                        {t('common.buyNow')}
                      </Button>
                    </article>
                  ))
                }
              </Carousel>
            </div>
            {
              bottles.map((bottle) => (
                <article class='hidden flex-col items-center border border-eerie-black py-[1.125rem] md:flex'>
                  <Picture
                    alt={bottle.img.alt}
                    class='mb-4 h-[260px] object-cover'
                    height={260}
                    src={bottle.img.src}
                    loading='lazy'
                    formats={['webp', 'avif', 'jpg']}
                  />
                  <h2
                    translate='no'
                    class='mb-3 text-center uppercase md:text-sm lg:text-2xl'
                  >
                    {bottle.title}
                  </h2>
                  <p
                    translate='no'
                    class='mb-3 text-center md:text-xs lg:text-xl'
                  >
                    {t('common.bottle')} {bottle.size}ml
                  </p>
                  <Button as='a' href={translatePath(bottle.link)}>
                    {t('common.buyNow')}
                  </Button>
                </article>
              ))
            }
          </div>
        </SandLayout>
      </SandLayout>
    </BaseLayout>
  </MiddlewareLayout>
</Layout>
<script>
  import { useTranslations } from 'i18n/utils'
  import { getCocktailImg } from 'coctel/coctel.usecases'
  import type { Coctel } from 'coctel/coctel.domain'
  import { cocteles } from 'coctel/coctel.const'

  const $ = document.querySelector.bind(document)
  const t = useTranslations()
  const scrollToEl = $('#scroll-to')
  const recipes = $('#recipes')
  const $coctelesCount = $('#cocteles-count') as HTMLTitleElement
  const $cocteles = $('#cocteles') as HTMLDivElement
  const $formFilter = $('#form-filter') as HTMLFormElement

  const createCocktail = (cocktail: Coctel) => {
    const wrapper = document.createElement('article')
    wrapper.classList.add(
      'grid',
      'grid-cols-[auto_auto]',
      'grid-rows-[284px_auto]',
      'gap-y-[0.625rem]'
    )
    wrapper.insertAdjacentHTML(
      'afterbegin',
      `
      <div class="col-span-2 row-start-1">
        <image
          class="col-span-2 row-start-1 h-full w-full object-cover object-[10%_80%]"
          src=${getCocktailImg(cocktail.alias).src}
          alt=${cocktail.alias}
          loading="lazy"
          height="284"
        />
      </div>
      <h1
        class="col-span-1 row-start-2 self-center justify-self-start hyphens-auto text-sm uppercase text-rosewood [overflow-wrap:anywhere] md:text-xs lg:text-sm"
      >
        ${cocktail.name.toUpperCase()}
      </h1>
      <span class="col-span-1 rounded-[1.25rem] border border-rosewood row-start-2 self-center justify-self-end px-[18px] py-[0.375rem] text-[0.625rem] font-bold text-rosewood md:px-1.5">
        ${cocktail.distillate}
      </span>
      `
    )

    return wrapper
  }

  const createNotFound = document.createElement('h1')
  createNotFound.innerText = t('common.resultsNotFound')
  createNotFound.classList.add(
    'text-center',
    'font-bold',
    'col-span-3',
    'font-bold',
    'text-sm'
  )

  $formFilter?.addEventListener('input', (e) => {
    const form = new FormData(e.currentTarget as HTMLFormElement)
    const productFilter = Object.fromEntries(form.entries())
    const text = (productFilter.searchbox as string).trim()
    const foundCocktails = cocteles
      .filter(
        (v) =>
          v.name.toLowerCase().includes(text.toLowerCase()) &&
          v.distillate.includes(productFilter.distillate.toString())
      )
      .map((cocktail) => createCocktail(cocktail))
    foundCocktails.length
      ? $cocteles.replaceChildren(...foundCocktails)
      : $cocteles.replaceChildren(createNotFound)

    const count = $cocteles.querySelectorAll('article').length
    $coctelesCount.innerText = `${count}`
  })

  scrollToEl?.addEventListener('click', () => {
    recipes?.scrollIntoView({ behavior: 'smooth' })
  })
</script>
