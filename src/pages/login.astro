---
import { changeLanguage } from "i18next";
import { Picture } from "astro:assets";
import Button from "components/Button.astro";
import Input from "components/Input.astro";
import BaseLayout from "layouts/BaseLayout.astro";
import Layout from "layouts/Layout.astro";
import SandLayout from "layouts/SandLayout.astro";
import MiddlewareLayout from "layouts/MiddlewareLayout.astro";
import Master3 from "images/master-3.jpg";
import { getLangFromUrl, useTranslatedPath, useTranslations } from "i18n/utils";

changeLanguage("es");

const lang = getLangFromUrl(Astro.url);
const t = useTranslations();
const translatePath = useTranslatedPath(lang);
---

<Layout title='DeCajon'>
  <MiddlewareLayout>
    <BaseLayout showNavbar={false}>
      <SandLayout>
        <div class='m-auto w-[76%] max-w-screen-2xl'>
          <div
            class='grid grid-cols-1 grid-rows-[auto_auto] gap-x-[5.25rem] pb-16 pt-28 md:grid-cols-2'
          >
            <article>
              <h1
                class='m-auto mb-10 w-3/4 text-center text-xl uppercase lg:text-4xl xl:w-1/2'
              >
                {t('login.welcome')}
              </h1>
              <form id='login'>
                <Input
                  required
                  autofocus='on'
                  name='username'
                  autocomplete='off'
                  htmlFor='username'
                  class='mb-5'
                  label='Usuario'
                />
                <Input
                  required
                  class='outline-rosewood [&&]:border-rosewood'
                  name='password'
                  autocomplete='off'
                  htmlFor='password'
                  label='Contraseña'
                  type='password'
                />
                <a
                  class='block text-right text-xs text-rosewood'
                  href={translatePath('/')}>{t('login.forgetAccount')}</a
                >
                <p
                  id='invalid-user'
                  class='invisible mb-0 mt-3 text-xs font-bold text-rosewood'
                >
                  {t('login.invalidAuth')}
                </p>
                <Button as='button' type='submit' class='mt-5 block w-full'>
                  {t('login.signin')}
                </Button>
              </form>
              <p class='mt-8 text-center text-xs lg:text-base'>
                {t('login.notAccount')}
                <a class='text-rosewood' href={translatePath('/signup')}
                  >&nbsp;{t('login.signup')}</a
                >
              </p>
            </article>
            <Picture
              alt='maestro-3'
              class='h-full rounded-[2.5rem] object-cover'
              pictureAttributes={{ class: 'hidden md:block' }}
              loading='lazy'
              src={Master3}
              formats={['webp', 'avif', 'jpeg']}
            />
          </div>
        </div>
      </SandLayout>
    </BaseLayout>
  </MiddlewareLayout>
</Layout>
<script>
  import { setToken } from 'adapters/jwt'
  import { getLangFromUrl, useTranslatedPath } from 'i18n/utils'

  const $ = document.querySelector.bind(document)
  const lang = getLangFromUrl(
    new URL(window?.location?.pathname, window?.location?.origin)
  )
  const translatePath = useTranslatedPath(lang)
  const $form = $('form#login') as HTMLFormElement
  const $submit = $('form > button') as HTMLButtonElement
  $form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    $submit.disabled = true
    $submit.classList.toggle('opacity-75')
    $submit.insertAdjacentHTML(
      'afterbegin',
      `
      <div
        class='border-current text-surface dark:text-white inline-block size-3 animate-spin rounded-full border-4 border-solid border-e-transparent align-[-0.125em] motion-reduce:animate-[spin_1.5s_linear_infinite]'
        role='status'
      >
        <span class='!absolute !-m-px !h-px !w-px !overflow-hidden !whitespace-nowrap !border-0 !p-0 ![clip:rect(0,0,0,0)]' >Loading...</span>
      </div>
      `
    )
    const formData = new FormData(e.target as HTMLFormElement)
    const body = JSON.stringify(Object.fromEntries(formData.entries()))
    try {
      const fetching = await fetch(
        `${import.meta.env.PUBLIC_DECAJON_API}/auth.php`,
        {
          method: 'POST',
          body,
          headers: {
            'Content-Type': 'application/json;charset=UTF-8',
          },
        }
      )
      if (!fetching.ok) {
        throw new Error(`Fetch error: ${fetching.statusText}`)
      }
      const res = await fetching.json()
      setToken(res.token)
      Array.from($form.querySelectorAll('input')).forEach((input) => {
        input?.classList.add('border-eerie-black')
      })
      window.location.replace(translatePath('/dashboard'))
    } catch (e) {
      $form.querySelector('#invalid-user')?.classList.remove('invisible')
      Array.from($form.querySelectorAll('input')).forEach((input) => {
        input?.classList.add('border-rosewood')
      })
    } finally {
      $submit.removeAttribute('disabled')
      $submit.classList.toggle('opacity-75')
      $submit.querySelector('[role="status"]')?.remove()
    }
  })
</script>
