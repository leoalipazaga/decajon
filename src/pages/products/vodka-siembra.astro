---
import { changeLanguage } from "i18next";
import { Image, Picture } from "astro:assets";
import ProductPhotos from "organism/product-photos.astro";
import ProductInfo from "organism/product-info.astro";
import ProductDescription from "components/product/product-description.astro";
import ProductLayout from "components/product/product-layout.astro";
import BottleSiembra from "images/bottle-siembra.png";
import WorldSpiritBottle from "images/world-spirit-bottle.png";
import Pucara from "images/pucara.png";
import BlackBull from "images/black-bull.png";
import DeCajonGin from "images/decajon-gin.png";
import Siembra1 from "images/siembra-1.jpeg";
import Siembra2 from "images/siembra-2.jpeg";
import Siembra3 from "images/siembra-3.jpeg";
import Siembra4 from "images/siembra-4.jpeg";
import SiembraBanner from "images/siembra-banner.png";
import SiembraDescrition from "images/siembra-description.png";
import Button from "components/Button.astro";
import AngleLeft from "icons/angle-left.svg";
import AngleRight from "icons/angle-right.svg";
import LongLeftArrow from "icons/long-left-arrow.svg";
import { getLangFromUrl, useTranslatedPath, useTranslations } from "i18n/utils";

changeLanguage("es");

const lang = getLangFromUrl(Astro.url);
const t = useTranslations();
const translatePath = useTranslatedPath(lang);
const getTitleById = (id: number) => {
    if (id === 1) {
        return "DE CAJ\u00D3N VODKA";
    }
    if (id === 2) {
        return "DE CAJ\u00D3N GIN";
    }
    return "DE CAJ\u00D3N Siembra";
};
const siembraName = getTitleById(3);
---

<ProductLayout>
  <Fragment slot='default'>
    <div
      class='m-auto flex max-w-screen-2xl transition-transform ease-linear'
      id='carousel-banner-content'
    >
      <div
        class='relative mr-auto hidden w-full max-w-screen-2xl grid-cols-[2fr_1.5fr] gap-y-6 pb-[2.125rem] pl-[12%] pt-[6.375rem] md:ml-auto md:grid md:flex-shrink-0 md:grid-cols-[2fr_1fr_1fr_3fr] md:gap-y-[0.625rem] xl:grid-cols-[2fr_1fr_1fr_3fr] xl:gap-y-[1.875rem]'
      >
        <ul
          class='col-start-1 row-start-2 hidden gap-3 justify-self-start md:flex'
        >
          <li>
            <Button
              class='[&&]:bg-gentian-blue'
              id='prev-banner-button'
              variant='rounded'
            >
              <Image src={AngleLeft} alt='angle-left' />
            </Button>
          </li>
          <li>
            <Button
              class='[&&]:bg-gentian-blue'
              id='next-banner-button'
              variant='rounded'
            >
              <Image src={AngleRight} alt='angle-right' />
            </Button>
          </li>
        </ul>
        <p
          class='col-start-1 row-start-3 hidden text-left md:block lg:text-sm xl:text-base'
        >
          Siembra Vodka
        </p>
        <h1
          class='col-start-1 -col-end-1 row-start-1 ml-[12%] text-center text-xl uppercase md:col-start-1 md:col-end-2 md:row-start-4 md:ml-0 md:text-left lg:text-2xl xl:text-4xl'
        >
          {t('siembra.banner')}
        </h1>
        <p
          class='col-start-1 -col-end-1 row-start-2 ml-[12%] text-center text-xs md:col-start-1 md:col-end-2 md:row-start-5 md:ml-0 md:text-left lg:text-sm xl:text-base'
        >
          {t('siembra.description')}
        </p>
        <Picture
          src={SiembraBanner}
          loading='lazy'
          pictureAttributes={{
            class:
              'md:col-start-3 md:row-start-5 md:col-end-5 md:row-end-9 row-start-5 row-end-6 col-start-1 -col-end-1 justify-self-start',
          }}
          formats={['png', 'webp', 'avif']}
          alt='SiembraBanner'
        />
        <Picture
          src={BottleSiembra}
          loading='lazy'
          class='object-fill'
          pictureAttributes={{
            class:
              'md:col-start-2 md:row-start-1 md:col-end-4 md:row-end-8 col-start-2 row-start-4 row-end-7 justify-self-end',
          }}
          formats={['png', 'webp', 'avif']}
          alt='BottleSiembra'
        />
        <Button
          as='a'
          href={translatePath('/products/vodka-siembra')}
          class='col-start-1 -col-end-1 row-start-3 ml-[12%] justify-self-center md:col-start-1 md:col-end-2 md:row-start-6 md:ml-0 md:justify-self-start [&&]:bg-gentian-blue'
          >{t('common.showMore')}</Button
        >
        <div class='absolute left-1/2 top-[83%] hidden animate-bounce md:block'>
          <Button class='[&&]:bg-gentian-blue' variant='rounded' id='scroll-to'>
            <Image class='-rotate-90' src={LongLeftArrow} alt='angle-left' />
          </Button>
        </div>
      </div>
      <div
        class='relative hidden w-full max-w-screen-2xl grid-cols-[1fr_2fr] gap-y-6 pb-[2.125rem] pr-[12%] pt-[6.375rem] md:grid md:flex-shrink-0 md:grid-cols-[2fr_1fr_1.5fr] md:gap-y-[0.625rem] xl:grid-cols-[2fr_1fr_1fr] xl:gap-y-[1.875rem]'
      >
        <ul
          class='col-start-3 row-start-2 hidden gap-3 justify-self-end md:flex'
        >
          <li>
            <Button
              id='prev-banner-button'
              class='[&&]:bg-eerie-black'
              variant='rounded'
            >
              <Image src={AngleLeft} alt='angle-left' />
            </Button>
          </li>
          <li>
            <Button
              id='next-banner-button'
              class='[&&]:bg-eerie-black'
              variant='rounded'
            >
              <Image src={AngleRight} alt='angle-right' />
            </Button>
          </li>
        </ul>
        <p
          translate='no'
          class='col-start-3 row-start-3 hidden text-right md:block lg:text-sm xl:text-base'
        >
          De Cajón Gin
        </p>
        <h1
          class='col-start-1 -col-end-1 row-start-1 mr-[12%] text-center text-xl uppercase md:col-start-3 md:row-start-4 md:mr-0 md:text-right lg:text-2xl xl:text-4xl'
        >
          {t('gin.banner')}
        </h1>
        <p
          class='col-start-1 -col-end-1 row-start-2 mr-[12%] text-center text-xs md:col-start-3 md:row-start-5 md:mr-0 md:text-right lg:text-sm xl:text-base'
        >
          {t('gin.description')}
        </p>
        <Picture
          src={BlackBull}
          loading='lazy'
          pictureAttributes={{
            class:
              'md:col-start-1 md:row-start-2 md:col-end-3 md:row-end-8 row-start-5 row-end-6 col-start-1 -col-end-1 justify-self-start',
          }}
          formats={['png', 'webp', 'avif']}
          alt='BlackBull'
        />
        <Picture
          src={DeCajonGin}
          loading='lazy'
          class='object-fill'
          pictureAttributes={{
            class:
              'md:col-start-2 md:row-start-1 md:row-end-8 col-start-1 row-start-4 row-end-6 justify-self-end',
          }}
          formats={['png', 'webp', 'avif']}
          alt='DeCajonGin'
        />
        <Button
          as='a'
          href={translatePath('/products/vodka-gin')}
          class='col-start-1 -col-end-1 row-start-3 mr-[12%] self-start justify-self-center md:col-start-3 md:row-start-6 md:mr-0 md:justify-self-end [&&]:bg-eerie-black'
          >{t('common.showMore')}</Button
        >
        <div class='absolute left-1/2 top-[83%] hidden animate-bounce md:block'>
          <Button class='[&&]:bg-eerie-black' variant='rounded' id='scroll-to'>
            <Image class='-rotate-90' src={LongLeftArrow} alt='angle-left' />
          </Button>
        </div>
      </div>
      <div
        class='relative ml-auto grid w-full flex-shrink-0 grid-cols-[minmax(0,3fr)_minmax(0,1fr)] grid-rows-[auto_auto] items-center pb-[2.125rem] pl-[12%] pt-[6.375rem] md:grid-cols-[2fr_0.5fr_1fr_2fr_2.5fr] lg:md:grid-cols-[2fr_0.5fr_1fr_3fr_1fr_2.5fr] lg:grid-rows-[min-content_auto]'
      >
        <Image
          class='col-start-1 row-start-2 -row-end-1 h-full object-contain object-center md:col-start-2 md:col-end-5 md:row-start-1 lg:col-end-6 lg:object-top'
          src={WorldSpiritBottle}
          alt='World Spirit Man'
        />
        <ul
          class='col-start-1 row-start-1 mb-4 hidden gap-2 self-end md:flex lg:mb-[2.125rem]'
        >
          <li>
            <Button variant='rounded' id='prev-banner-button'>
              <Image src={AngleLeft} alt='angle-left' />
            </Button>
          </li>
          <li>
            <Button variant='rounded' id='next-banner-button'>
              <Image src={AngleRight} alt='angle-right' />
            </Button>
          </li>
        </ul>
        <header
          class='col-start-1 -col-end-1 row-start-1 mr-[12%] flex flex-col items-center justify-start gap-[0.875rem] self-start md:col-end-3 md:row-start-2 md:mr-0 md:items-start lg:col-end-4'
        >
          <p translate='no' class='text-center text-base sm:text-left'>
            De Cajón Vodka
          </p>
          <h1
            class='text-center text-xl sm:text-left md:w-4/5 lg:text-2xl xl:text-4xl'
          >
            {t('vodka.banner')}
          </h1>
          <p class='text-center text-xs md:text-left lg:text-sm xl:text-base'>
            {t('vodka.description')}
          </p>
          <Button
            as='a'
            href={translatePath('/products/vodka')}
            class='w-max self-center md:self-start'
            >{t('common.showMore')}</Button
          >
        </header>
        <Picture
          src={Pucara}
          class='h-full object-contain'
          pictureAttributes={{
            class:
              'md:col-start-4 self-start translate-x-1/4 md:translate-x-0 -translate-y-1/4 md:translate-y-0  -col-end-1 -z-10 row-start-2 lg:row-start-1 md:-row-end-1 col-start-1',
          }}
          formats={['webp', 'avif', 'png']}
          alt='World Spirit Man'
        />
        <div class='absolute left-1/2 top-[83%] hidden animate-bounce md:block'>
          <Button class='[&&]:bg-rosewood' variant='rounded' id='scroll-to'>
            <Image class='-rotate-90' src={LongLeftArrow} alt='angle-left' />
          </Button>
        </div>
      </div>
    </div>
  </Fragment>
  <Fragment slot='information'>
    <ProductPhotos
      banner={{ alt: 'DeCajonGin1', src: Siembra1 }}
      bottom={[
        { alt: 'DeCajonGin2', src: Siembra2 },
        { alt: 'DeCajonGin3', src: Siembra3 },
        { alt: 'DeCajonGin4', src: Siembra4 },
      ]}
    />
    <ProductInfo id={3} title='SIEMBRA VODKA' price={34}>
      <Fragment slot='default'>
        {t('products.siembraSummary')}
      </Fragment>
      <Fragment slot='counter'>
        <div
          id='product-counter'
          class='col-start-1 row-start-1 flex min-w-min flex-row items-center justify-between gap-1 text-nowrap rounded-[1.25rem] border border-rosewood px-7 py-1.5 text-xs text-eerie-black sm:col-start-2 sm:gap-4 lg:px-[2.625rem] lg:text-base [&&]:p-1 [&&]:px-2'
        >
          <button
            id='product-counter-inc'
            class='flex h-[2.5rem] w-[2.5rem] items-center justify-center rounded-full bg-rosewood font-bold text-anti-flash-white [&&]:h-7 [&&]:w-7'
            >+</button
          >
          <span id='product-counter-display' class='w-4 text-center font-bold'
          ></span>
          <button
            id='product-counter-dec'
            class='flex h-[2.5rem] w-[2.5rem] items-center justify-center rounded-full bg-rosewood font-bold text-anti-flash-white [&&]:h-7 [&&]:w-7'
          >
            -
          </button>
        </div>
      </Fragment>
      <Fragment slot='action'>
        <button
          data-item-id={3}
          data-toast-added-i18n={`${siembraName} ${t('cart.productAddedToCart')}`}
          class='col-span-2 row-start-4 mt-6 w-auto text-nowrap rounded-[1.25rem] bg-rosewood px-3 py-2 text-zinc-1000 md:col-span-1 md:col-start-1 md:row-start-5 md:mt-0 md:self-end'
          id='shop'>{t('common.buyNow')}</button
        >
      </Fragment>
    </ProductInfo>
  </Fragment>
  <Fragment slot='description'>
    <ProductDescription
      title={t('products.potatoDestillate')}
      descriptions={[
        `${t('products.alcohol')}: ${t('products.siembraAlcohol')}`,
        `${t('products.origin')}: ${t('products.siembraOrigin')}`,
        `${t('products.presentation')}: ${t('products.siembraPresentation')}`,
      ]}
      ><div class='siembra--banner'>
        <Picture
          class='aspect-square max-h-[33rem] object-contain md:aspect-auto md:h-full'
          formats={['webp', 'avif', 'jpeg']}
          loading='lazy'
          alt='SiembraDescription'
          src={SiembraDescrition}
        />
      </div>
    </ProductDescription>
  </Fragment>
</ProductLayout>
<style>
  .siembra--banner {
    background: radial-gradient(
      50% 50% at 50% 50%,
      rgba(249, 62, 233, 0.57) 0%,
      rgba(169, 25, 157, 0.57) 49.5%,
      rgba(79, 193, 218, 0.57) 100%
    );
  }
</style>
<script>
  import { UserCart } from 'adapters/cart'
  import type { Product } from 'adapters/storage.types'
  import { products } from 'consts'
  import { Toast } from 'ui/Toast'

  const $ = document.querySelector.bind(document)
  const $$ = document.querySelectorAll.bind(document)
  const $vodkaDescription = $('#vodka-description')
  const $leftButton = $$('#prev-banner-button')
  const $rightButton = $$('#next-banner-button')
  const carouselContentEl = $('#carousel-banner-content')
  const itemsCount = carouselContentEl?.children.length ?? 0
  const $counter = $('#product-counter') as HTMLDivElement
  const $shop = $('#shop') as HTMLButtonElement
  const $counterInc = $counter.querySelector(
    '#product-counter-inc'
  ) as HTMLButtonElement
  const $counterDec = $counter.querySelector(
    '#product-counter-dec'
  ) as HTMLButtonElement
  const $counterDisplay = $counter.querySelector(
    '#product-counter-display'
  ) as HTMLSpanElement
  const itemId = $shop.dataset.itemId as string
  const toastMessageOnAdded = $shop.dataset.toastAddedI18n as string

  $counterDisplay.innerText = `${UserCart.getItemBy(+itemId)?.count || 1}`

  let counter = 0

  Array.from($leftButton)?.forEach?.((btn) =>
    btn?.addEventListener('click', () => {
      counter = !counter ? itemsCount - 1 : counter - 1
      const translateWidth = -100 * counter
      carouselContentEl?.setAttribute(
        'style',
        `transform: translateX(${translateWidth}%)`
      )
    })
  )

  Array.from($rightButton)?.forEach((btn) =>
    btn?.addEventListener('click', () => {
      counter = counter >= itemsCount - 1 ? 0 : counter + 1
      const translateWidth = -100 * counter
      carouselContentEl?.setAttribute(
        'style',
        `transform: translateX(${translateWidth}%)`
      )
    })
  )

  const $scrollsTo = $$('#scroll-to') as NodeListOf<HTMLDivElement>
  $scrollsTo?.forEach(($scrollTo) => {
    $scrollTo.addEventListener('click', () => {
      $vodkaDescription?.scrollIntoView({ behavior: 'smooth' })
    })
  })

  $counterInc.addEventListener('click', () => {
    const currentCount = +$counterDisplay.innerText
    $counterDisplay.innerText = `${currentCount + 1}`
  })

  $counterDec.addEventListener('click', () => {
    const currentCount = +$counterDisplay.innerText
    $counterDisplay.innerText = `${Math.max(1, currentCount - 1)}`
  })

  $shop.addEventListener('click', () => {
    const item = products.get(+itemId) as Product
    const currentCount = +$counterDisplay.innerText
    new Toast({
      text: toastMessageOnAdded,
    })
    UserCart.updateCart({ ...item, count: currentCount })
  })
</script>
