---
import { getLangFromUrl, useTranslations } from 'i18n/utils'
import Input from 'components/Input.astro'
import Button from 'components/Button.astro'
import Modal from 'organism/Modal.astro'
import { currency } from 'utils'
import ModalBody from './ModalBody.astro'

interface Props {
  type: 'PROVIDER' | 'USER'
  continueShop: string
}

const { continueShop, type } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<form
  data-type={type}
  id="formCheckout"
  class="hidden grid-cols-1 md:grid-cols-2 md:gap-x-24"
>
  <article class="grid grid-cols-2">
    <header class="col-span-2 mb-10 flex flex-col md:flex-row">
      <h1
        class="col-span-2 text-xl uppercase md:col-span-1 md:text-2xl lg:text-center"
      >
        {t('checkout.finishShop')}
      </h1>
      <h3
        id="countProducts"
        class="col-span-2 text-nowrap text-xl md:col-span-1 lg:text-center"
      >
      </h3>
    </header>
    <p class="col-span-2 text-base md:text-xl">
      {t('checkout.detailsShop')}
    </p>
    <Input
      required
      autocomplete="off"
      class="col-span-2 mb-4"
      label="Nombre"
      name="name"
      id="name"
    />
    <Input
      required
      autocomplete="off"
      class="col-span-2 mb-4"
      label="Apellidos"
      name="lastname"
      id="lastname"
    />
    <p translate="no" class="col-span-2 mb-4">Lima/Perú</p>
    <label class="col-span-2 text-xs">{t('checkout.district')}</label>
    <select
      required
      id="districts"
      class="col-span-2 mb-4 border border-eerie-black bg-transparent px-2.5 py-1"
      name="district"
    >
    </select>
    <Input
      required
      autocomplete="off"
      class="col-span-2 mb-4"
      label="Direccion"
      name="address"
      id="address"
    />
    <input id="regions" name="regions" hidden value="3926" />
    <input id="provinces" name="provinces" hidden value="3927" />
    <Input
      required
      autocomplete="off"
      class="col-span-2 mb-4"
      type="tel"
      label={t('common.phone')}
      id="phone"
      name="phone"
    />
    <Input
      required
      autocomplete="off"
      class="col-span-2 mb-4"
      type="email"
      label={t('common.email')}
      id="email"
      name="email"
    />
    <label class="col-span-2 text-xs">{t('checkout.notes')}</label>
    <textarea
      class="col-span-2 min-h-40 border border-eerie-black bg-transparent px-2.5 py-1"
      name="notes"></textarea>
    <Button
      as="button"
      data-modal-trigger="mp-form-card"
      id="buttonCheckout"
      class="col-span-2 mt-10 block md:hidden"
    >
      {t('checkout.finishShop')}
    </Button>
  </article>
  <article class="hidden md:block">
    <a class="mb-10 block text-base text-rosewood" href={continueShop}>
      {t('cart.continueShop')}
    </a>
    <div class="grid grid-cols-2 border px-4 py-5">
      <h2 class="col-span-2 mb-9 text-center font-thabit text-xl">
        {t('checkout.yourOrder')}
      </h2>
      <div class="col-span-2 grid grid-cols-2 px-[0.625rem] py-4">
        <h4 class="font-thabit text-base font-bold">{t('checkout.product')}</h4>
        <h4 class="justify-self-end font-thabit text-base font-bold">
          {t('common.subtotal')}
        </h4>
      </div>
      <slot name="cart" />
      <div class="col-span-2 grid grid-cols-2 border-b px-[0.625rem] py-4">
        <p class="text-base">{t('checkout.delivery')}:</p>
        <p id="delivery" class="justify-self-end text-base">{currency(10)}</p>
      </div>
      <div class="col-span-2 grid grid-cols-2 border-b px-[0.625rem] py-4">
        <p class="text-base">{t('common.total')}:</p>
        <p id="total" class="justify-self-end text-base"></p>
      </div>
      <Button
        type="submit"
        data-modal-trigger="mp-form-card"
        id="buttonCheckout"
        class="relative col-span-2 mt-10 block"
      >
        {t('checkout.finishShop')}
      </Button>
    </div>
  </article>
</form>
<Modal id="mp-form-card">
  <ModalBody id="checkout-mercado-pago-form">
    <div class="p-0" id="cardPaymentBrick_container"></div>
  </ModalBody>
</Modal>
<Modal id="mp-status-screen">
  <ModalBody>
    <div class="p-0" id="statusScreenBrick_container"></div>
  </ModalBody>
</Modal>
<div
  id="empty"
  class="hidden grid-cols-1 gap-x-6 gap-y-[0.875rem] md:grid-cols-3"
>
  <h2
    class="col-span-3 border-y border-y-eerie-black py-6 text-center text-sm uppercase"
  >
    {t?.('cart.empty')}
  </h2>
  <slot />
</div>
<script is:inline src={import.meta.env.PUBLIC_MERCADO_PAGO_SCRIPT}></script>
<script>
  import { districts, shippingCost } from 'consts'
  import { currency } from 'utils'
  import { getLangFromUrl, useTranslations } from 'i18n/utils'
  import { ProviderCart, UserCart } from 'adapters/cart'
  import { createBrickSettings, createStatusBrick } from 'adapters/mercadopago'
  import { closeModal, openModal } from './modal'

  const $ = document.querySelector.bind(document)
  const $$ = document.querySelectorAll.bind(document)
  const lang = getLangFromUrl(
    new URL(window?.location?.pathname, window?.location?.origin)
  )
  const $delivery = $('#delivery') as HTMLParagraphElement
  const $modalBricks = $('#mp-form-card') as HTMLDialogElement
  const $modalStatus = $('#mp-status-screen') as HTMLDialogElement
  const $provinces = $('#provinces')
  const $districts = $('#districts') as HTMLSelectElement
  const $countProducts = $$('#countProducts')
  const $$total = $$('#total') as NodeListOf<HTMLParagraphElement>
  const $email = $('#email') as HTMLInputElement
  const $empty = $('#empty') as HTMLDivElement
  const $formCheckout = $('#formCheckout') as HTMLFormElement
  const t = useTranslations(lang)
  const isUser = $formCheckout.dataset.type === 'USER'
  const cart = isUser ? UserCart : ProviderCart
  if (cart.getTotal()) {
    $formCheckout.classList.toggle('hidden')
    $formCheckout.classList.toggle('grid')
  } else {
    $empty.classList.toggle('hidden')
    $empty.classList.toggle('grid')
  }

  const getDelivery = (districtId: string) => {
    const district = shippingCost.find((item) => item.id_ubigeo === districtId)
    return district?.shippingCost
  }

  $delivery.innerText = currency(getDelivery('3970') ?? 15)

  $$total?.forEach(($el) => {
    const delivery = getDelivery('3970') ?? 15

    $el?.insertAdjacentText(
      'afterbegin',
      `${currency(cart.getTotal() + delivery)}`
    )
  })

  $countProducts?.forEach(($el) => {
    $el?.insertAdjacentText(
      'afterbegin',
      `(${cart.getCountProducts()} ${cart.getCountProducts() === 1 ? t('common.product') : t('common.products')})`
    )
  })

  const getDistricts = (ubigeo: keyof typeof districts) => {
    return [...districts[ubigeo]].sort((a, b) =>
      a.nombre_ubigeo < b.nombre_ubigeo ? 1 : -1
    )
  }

  getDistricts(
    ($provinces as HTMLInputElement)?.value as keyof typeof districts
  ).forEach((district) => {
    $districts?.insertAdjacentHTML(
      'afterbegin',
      `<option id=${district.id_ubigeo} value=${district.id_ubigeo}>${district.nombre_ubigeo}</option>`
    )
  })

  $districts.addEventListener('change', (e: any) => {
    const delivery = getDelivery(e.target?.value) ?? 15
    $delivery.innerText = currency(delivery)
    $$total?.forEach(($el) => {
      if ($el) {
        $el.innerText = `${currency(cart.getTotal() + delivery)}`
      }
    })
  })

  $modalBricks
    .querySelector('[data-modal-close]')
    ?.addEventListener('click', () => {
      ;(window as any).paymentBrickController?.unmount()
    })

  $modalBricks.addEventListener(
    'click',
    (event) => {
      if (event.target === $modalBricks) {
        closeModal($modalBricks)
        ;(window as any).paymentBrickController?.unmount()
      }
    },
    { once: true }
  )

  $modalStatus
    .querySelector('[data-modal-close]')
    ?.addEventListener('click', () => {
      ;(window as any).statusScreenBrickController?.unmount()
      ;(window as any).paymentBrickController?.unmount()
    })

  $modalStatus.addEventListener(
    'click',
    (event) => {
      closeModal($modalStatus)
      ;(window as any).statusScreenBrickController?.unmount()
      ;(window as any).paymentBrickController?.unmount()
    },
    { once: true }
  )

  $formCheckout.addEventListener('submit', async (e) => {
    e.preventDefault()
    const mp = new (window as any).MercadoPago(
      import.meta.env.PUBLIC_MERCADO_PAGO_PUBLIC_KEY
    )
    const bricksBuilder = mp.bricks()
    const brickSettings = createBrickSettings({
      amount: cart.getTotal() + (getDelivery($districts.value) ?? 15),
      email: $email.value ?? '',
      onSuccess: async (res: any) => {
        if (res.data.status === 'approved') {
          cart.clearCart()
        }
        const statusBrickSettings = createStatusBrick(res.data.id)
        ;(window as any).statusScreenBrickController =
          await bricksBuilder.create(
            'statusScreen',
            'statusScreenBrick_container',
            statusBrickSettings
          )
        openModal($modalStatus)
        closeModal($modalBricks)
      },
    })
    ;(window as any).paymentBrickController = await bricksBuilder.create(
      'cardPayment',
      'cardPaymentBrick_container',
      brickSettings
    )
  })
</script>
